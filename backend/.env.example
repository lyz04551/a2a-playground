# Backend / Host Agent configuration
# Copy to backend/.env for direct Backend startup.

# Host-owned OpenAI-compatible model
HOST_LLM_PROVIDER=deepseek
HOST_LLM_BASE_URL=https://api.deepseek.com/v1
HOST_LLM_MODEL=deepseek-chat
HOST_LLM_API_KEY=

# Host orchestration limits
HOST_MAX_TASKS=12
HOST_MAX_ROUNDS=8
HOST_MAX_CONCURRENCY=3
HOST_MAX_ATTEMPTS=2

# Backend-to-A2A Agent timeout in seconds
A2A_CLIENT_TIMEOUT=120

# Persistence
PLAYGROUND_DB_PATH=backend/data/playground-local.db
PLAYGROUND_DB_BUSY_TIMEOUT_MS=5000

# Optional Agent bootstrap definitions for non-Compose startup
BOOTSTRAP_AGENTS=[]

# HTTP security
PLAYGROUND_API_KEY=
PLAYGROUND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLAYGROUND_ALLOW_PRIVATE_AGENTS=true

# Backward-compatible fallback; dedicated HOST_LLM_* values take precedence.
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=
