# K8s Security Agent configuration
# Copy to agents/k8s-security/.env for direct startup.

AGENT_PUBLIC_URL=http://127.0.0.1:8053
K8S_MCP_URL=http://10.2.0.57:9096/mcp
MCP_TRANSPORT=streamable_http

# This Agent's OpenAI-compatible model
AGENT_LLM_PROVIDER=openai-compatible
AGENT_LLM_BASE_URL=http://127.0.0.1:4000/v1
AGENT_LLM_MODEL=your-openai-compatible-model
AGENT_LLM_API_KEY=

# Runtime limits
AGENT_RUN_TIMEOUT=180
AGENT_SUMMARY_RESERVE_SECONDS=35
AGENT_TIMEOUT_SAFETY_MARGIN_SECONDS=5
AGENT_MAX_STEPS=16
AGENT_MAX_TOOL_CALLS=12
MCP_SSE_READ_TIMEOUT=3600
MCP_TOOL_TIMEOUT=30

# Backward-compatible fallback; dedicated AGENT_LLM_* values take precedence.
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=
